# Authorization server defaults
AS_ISSUER=http://localhost:8080
AS_AUDIENCE=http://localhost:9090
AS_SIGNING_KEY_BASE64=ZGV2LXNpZ25pbmcta2V5LTEyMzQ=
AS_SIGNING_KEY_ID=dev-hs256
AS_DEFAULT_CLIENT_ID=client-xyz
AS_DEFAULT_CLIENT_SECRET=secret-xyz
AS_CODE_TTL_SECONDS=300
AS_ACCESS_TOKEN_TTL_SECONDS=3600
AS_REFRESH_TOKEN_TTL_SECONDS=86400
AS_OBO_TOKEN_TTL_SECONDS=900

# Resource server defaults
RS_AUDIENCE=http://localhost:9090
RS_LISTEN_ADDR=:9090

# Federated human sign-in via an upstream OIDC provider (e.g. Google).
# Leave UPSTREAM_* unset to disable: the sign-in button is hidden and the
# /auth/sso/* routes return 404.
#
# Google setup: Cloud console -> APIs & Services -> Credentials ->
# Create OAuth client ID -> Web application, then register this exact
# authorized redirect URI:
#
#     http://localhost:8080/auth/sso/callback
#
# PUBLIC_BASE_URL is what that redirect URI is built from, so it must match
# the address browsers actually use to reach the AS.
PUBLIC_BASE_URL=http://localhost:8080
UPSTREAM_ISSUER=https://accounts.google.com
UPSTREAM_CLIENT_ID=
UPSTREAM_CLIENT_SECRET=
UPSTREAM_SCOPES=openid,email,profile
UPSTREAM_DISPLAY_NAME=Google

# Trusted Auth Token (TAT) IdP mode — tokenator stands in for a customer's own
# identity provider, minting TATs that a third-party tenant consumes.
# Leave TAT_TENANT_HOST unset to disable (/tat/* returns 412).
#
# TAT_ISSUER must match the "Issuer" configured on the tenant's
# Configure -> Identity Provider screen, exactly. Because the tenant has to
# reach this server, it is a public tunnel URL, not localhost.
# TAT_TENANT_HOST is the bare tenant hostname; the callback is derived as
# https://<TAT_TENANT_HOST>/SSO/Callback.
# Upload the key from GET /tat/public-key.pem into the tenant's Public Keys.
# TAT_ISSUER: how the relying party identifies this IdP. It must be a URL the
# relying party can reach, so behind a tunnel it is the public tunnel URL, and
# it must match the "Issuer" field on the tenant's Identity Provider screen.
TAT_ISSUER=
# TAT_AUDIENCE: the relying party's Agent Identity authorization server. This is
# NOT the tunnel URL and NOT necessarily the callback host -- take it from
# 1Console. Defaults to https://<TAT_TENANT_HOST> when unset.
TAT_AUDIENCE=
# TAT_TENANT_HOST: bare tenant hostname; the token is POSTed to
# https://<TAT_TENANT_HOST>/SSO/Callback.
TAT_TENANT_HOST=
TAT_TOKEN_TTL_SECONDS=300
# Space-delimited scopes the end user may grant. A profile may override this
# with a "scopes" attribute.
TAT_SCOPES=openid profile email
# Comma-separated RAR types the end user may grant. Omitted from the token when
# empty, since an empty array can read as "may grant nothing".
TAT_AUTHORIZATION_DETAILS_TYPES=
